generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  firstName    String    @db.VarChar(45)
  middleName   String?   @db.VarChar(45)
  lastName     String    @db.VarChar(45)
  email        String    @unique @db.VarChar(255)
  username     String    @unique @db.VarChar(45)
  passwordHash String    @db.VarChar(255)
  googleId     String?   @unique @db.VarChar(64)
  resetToken   String?   @db.VarChar(64)
  resetExpires DateTime? @db.DateTime(3)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @db.DateTime(3)
}

model Book {
  id         Int      @id @default(autoincrement())
  bookName   String   @db.VarChar(100)
  authorName String   @db.VarChar(100)
  isbn       String   @unique @db.VarChar(13)
  coverFile  String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)
  issues     Issue[]
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  rollNo    String   @unique @db.VarChar(20)
  phoneNo   String   @db.VarChar(15)
  photoFile String?  @db.VarChar(255)
  country   String   @db.VarChar(60)
  state     String   @db.VarChar(60)
  city      String   @db.VarChar(60)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  issues    Issue[]
}

model Issue {
  id         Int         @id @default(autoincrement())
  bookId     Int
  studentId  Int
  issueDate  DateTime    @db.DateTime(3)
  returnDate DateTime?   @db.DateTime(3)
  status     IssueStatus @default(ISSUED)
  createdAt  DateTime    @default(now()) @db.DateTime(3)
  updatedAt  DateTime    @updatedAt @db.DateTime(3)
  book       Book        @relation(fields: [bookId], references: [id])
  student    Student     @relation(fields: [studentId], references: [id])

  @@index([bookId])
  @@index([studentId])
}

enum IssueStatus {
  ISSUED
  RETURNED
}